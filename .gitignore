```gitignore
# Compiled and build artifacts
*.js
*.ts
*.tsx
*.jsx
*.map

# Dependencies
node_modules/

# Logs and temp files
*.log
*.tmp
*.swp

# Editors
.vscode/
.idea/

# Build outputs
dist/
build/
target/
out/

# Environment
.env
.env.local
*.env.*

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
.env
.env.local

# Coverage reports
coverage/
htmlcov/
.coverage

# MyPy cache
.mypy_cache/

# Pytest cache
.pytest_cache/

# Gradle
.gradle/

# Temporary files
*.tmp
*.temp
*~
.DS_Store
Thumbs.db

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```